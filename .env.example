# Variables de entorno para actas-glpi
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el .env real al repositorio.

# URL base de la instancia GLPI (sin barra al final).
GLPI_URL=http://10.86.1.33/glpi/apirest.php

# Token de aplicación de la API de GLPI (obligatorio).
GLPI_APP_TOKEN=cambia_por_tu_app_token

# Token de usuario de la API de GLPI (obligatorio).
GLPI_USER_TOKEN=cambia_por_tu_user_token

# Orígenes que el navegador podrá llamar (CORS). En producción DEBE incluir
# el host real del frontend. Ejemplo con el servidor en 10.0.0.50:
# CORS_ALLOWED_ORIGINS=http://10.0.0.50,http://10.0.0.50:80
